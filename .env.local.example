# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# .env.local is gitignored. Never commit it.

NEXT_PUBLIC_SUPABASE_URL=https://nyvhnumdltwshrmozhgw.supabase.co

# "anon" / "publishable" key. Safe to expose to the browser. Used for auth and
# for all normal queries, which run under the signed-in user's row-level
# security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / "secret" key. Server-only, bypasses row-level security.
# Used only by the admin staff-creation flow. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only scripts/run-sql.mjs uses this, to apply migrations and seeds.
# The Supabase "session pooler" connection string:
#   Project Settings -> Database -> Connection string -> Session pooler
# URL-encode special characters in the password.
DATABASE_URL=

# --- Transactional email (Resend) ------------------------------------------
# Optional for now. Until both RESEND_API_KEY and RESEND_FROM are set, staff
# invites are shown on screen for an admin to pass on, not emailed.
#
# 1. Create a Resend account, add and verify the VeriClever sending domain
#    (DNS records: SPF + DKIM). Do not use a childcare operator's domain.
# 2. Create an API key (Sending access).
# 3. RESEND_FROM must be an address at the verified domain.
RESEND_API_KEY=
RESEND_FROM="VeriClever <noreply@example.com>"

# The public origin used to build links in emails. Localhost for dev; the
# deployed URL (e.g. https://app.vericlever.com) in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI Staff Q&A (Claude via AWS Bedrock, Sydney; search via Voyage AI) ----
# Step 58: Claude inference runs onshore through AWS Bedrock's Australian
# (au.*) inference profile. In production, Vercel authenticates to AWS via
# OIDC federation, assuming the vericlever-ai IAM role - no AWS keys in
# Vercel's own env vars. Locally (this file), AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY below authenticate a separate, narrowly-scoped IAM
# user for running scripts from a dev machine - OIDC federation only covers
# the deployed app, not local scripts.
#
# Search embeddings deliberately stayed on Voyage AI rather than also moving
# to Bedrock - see src/lib/ai/voyage.ts's header comment and BUILD_LOG.md,
# 28 September 2026: the only Bedrock embedding model available in Sydney
# (Titan Text Embeddings V2) missed retrieval on real staff questions,
# including a safety-critical one, against this tenant's real corpus.
#
# AI_MODEL_FAST must be an au.* Bedrock inference profile ID (Haiku 4.5,
# from the Bedrock console) - the shared client throws at startup otherwise.
AI_MODEL_FAST=au.anthropic.claude-haiku-4-5-20251001-v1:0

VOYAGE_API_KEY=

# Local dev only - a narrowly-scoped IAM user's keys (see comment above),
# never the vericlever-ai role's own credentials (that role is assumed via
# OIDC, not static keys, and has no long-lived credentials to copy here).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# Only read by scripts/compare-embedding-models.ts, to re-test embedding
# candidates on demand - not used by any production code path (see above).
AI_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Optional tuning, both have working defaults.
#
# Minimum cosine similarity for a chunk to be treated as relevant. Below
# roughly 0.40 the matches are noise; a correct answer scores 0.49 to 0.62.
# Defaults to 0.42 in code, so this only needs setting to override it.
AI_QA_MIN_SIMILARITY=0.42
#
# Caps on questions per person in a rolling 24 hours - a cost guard, not a
# usage policy. Defaults are 50 for staff and 150 for anyone at manager or
# admin tier, who field other people's questions as well as their own.
# Both only need setting to override the defaults.
AI_QA_DAILY_LIMIT_PER_STAFF=50
AI_QA_DAILY_LIMIT_PER_MANAGER=150
