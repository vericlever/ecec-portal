# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# .env.local is gitignored. Never commit it.

NEXT_PUBLIC_SUPABASE_URL=https://nyvhnumdltwshrmozhgw.supabase.co

# "anon" / "publishable" key. Safe to expose to the browser. Used for auth and
# for all normal queries, which run under the signed-in user's row-level
# security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / "secret" key. Server-only, bypasses row-level security.
# Used only by the admin staff-creation flow. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only scripts/run-sql.mjs uses this, to apply migrations and seeds.
# The Supabase "session pooler" connection string:
#   Project Settings -> Database -> Connection string -> Session pooler
# URL-encode special characters in the password.
DATABASE_URL=
